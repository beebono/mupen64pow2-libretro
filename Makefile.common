SOURCES_C += $(LIBRETRO_COMM_DIR)/libco/libco.c

ifeq ($(HAVE_NEON),1)
	SOURCES_ASM += $(LIBRETRO_COMM_DIR)/audio/conversion/float_to_s16_neon.S \
						$(LIBRETRO_COMM_DIR)/audio/conversion/s16_to_float_neon.S \
						$(LIBRETRO_COMM_DIR)/audio/resampler/drivers/sinc_resampler_neon.S
endif

### pow2 plugins: foir (video) and arMLEt (RSP) ###
# Both are built from their unmodified sources, as in the mupen64plus-pow2
# bundle: their plugin API gets the foir_ / armlet_ prefixes of
# custom/pow2/rename-*.h, and their dlsym() lookups of the core API are
# resolved by custom/pow2/pow2_host.c. They get the flags of their own
# builds instead of the core's: in particular no -ffast-math, since foir is
# bit-exact and arMLEt's native paths are held to its JIT's output.
SOURCES_C += $(POW2_DIR)/pow2_host.c

POW2_CPUOPTS = $(filter-out -ffast-math -funsafe-math-optimizations,$(CPUOPTS) $(PLATCFLAGS)) $(fpic) $(CPUFLAGS)
POW2_API_INC = -I$(CORE_DIR)/src/api

# foir
FOIR_SOURCES_C = \
	$(FOIR_DIR)/config.c \
	$(FOIR_DIR)/log.c \
	$(FOIR_DIR)/parser.c \
	$(FOIR_DIR)/setup.c \
	$(FOIR_DIR)/raster.c \
	$(FOIR_DIR)/mt.c \
	$(FOIR_DIR)/stats.c \
	$(FOIR_DIR)/overdraw.c \
	$(FOIR_DIR)/tmem.c \
	$(FOIR_DIR)/kernels_scalar.c \
	$(FOIR_DIR)/kernels_tex.c \
	$(FOIR_DIR)/kernels_neon.c \
	$(FOIR_DIR)/spec.c \
	$(FOIR_DIR)/vi.c \
	$(FOIR_DIR)/vi_filter.c \
	$(FOIR_DIR)/plugin.c \
	$(FOIR_DIR)/capture.c \
	$(FOIR_DIR)/framelog.c \
	$(POW2_DIR)/pow2_video.c

FOIR_CFLAGS = -std=gnu11 -fwrapv -fno-strict-aliasing $(POW2_API_INC) \
	-include $(POW2_DIR)/rename-foir.h -Ddlsym=pow2_dlsym

# foir's NEON kernels and specialised variants are aarch64 only
ifeq ($(WITH_DYNAREC), aarch64)
	FOIR_SOURCES_C += \
		$(FOIR_DIR)/kneon_comb.c \
		$(FOIR_DIR)/kneon_blend.c \
		$(FOIR_DIR)/kneon_mem.c \
		$(FOIR_DIR)/kneon_tex.c
	FOIR_CFLAGS += -DFOIR_NEON=1
endif

SOURCES_C += $(FOIR_SOURCES_C)
$(FOIR_SOURCES_C:.c=.o): CFLAGS = $(POW2_CPUOPTS) $(FOIR_CFLAGS)

# arMLEt, with its rsp-hle and parallel-rsp (GNU Lightning JIT)
ARMLET_SOURCES_C = \
	$(ARMLET_DIR)/src/plugin.c \
	$(ARMLET_DIR)/src/config.c \
	$(ARMLET_DIR)/src/hle_glue.c \
	$(ARMLET_DIR)/src/dispatch.c \
	$(ARMLET_DIR)/src/ustats.c \
	$(ARMLET_DIR)/src/gfx_ucode.c \
	$(ARMLET_DIR)/src/log.c \
	$(ARMLET_DIR)/src/rdp_defer.c \
	$(wildcard $(ARMLET_DIR)/src/hle/*.c) \
	$(wildcard $(ARMLET_DIR)/src/native/*.c)

ARMLET_HLE_SOURCES_C = \
	$(ARMLET_HLE_DIR)/alist.c \
	$(ARMLET_HLE_DIR)/alist_audio.c \
	$(ARMLET_HLE_DIR)/alist_naudio.c \
	$(ARMLET_HLE_DIR)/alist_nead.c \
	$(ARMLET_HLE_DIR)/audio.c \
	$(ARMLET_HLE_DIR)/cicx105.c \
	$(ARMLET_HLE_DIR)/hle.c \
	$(ARMLET_HLE_DIR)/hvqm.c \
	$(ARMLET_HLE_DIR)/jpeg.c \
	$(ARMLET_HLE_DIR)/memory.c \
	$(ARMLET_HLE_DIR)/mp3.c \
	$(ARMLET_HLE_DIR)/musyx.c \
	$(ARMLET_HLE_DIR)/re2.c

ARMLET_LIGHTNING_SOURCES_C = \
	$(ARMLET_PRSP_DIR)/lightning/lib/jit_disasm.c \
	$(ARMLET_PRSP_DIR)/lightning/lib/jit_memory.c \
	$(ARMLET_PRSP_DIR)/lightning/lib/jit_names.c \
	$(ARMLET_PRSP_DIR)/lightning/lib/jit_note.c \
	$(ARMLET_PRSP_DIR)/lightning/lib/jit_print.c \
	$(ARMLET_PRSP_DIR)/lightning/lib/jit_size.c \
	$(ARMLET_PRSP_DIR)/lightning/lib/lightning.c

ARMLET_SOURCES_CXX = \
	$(wildcard $(ARMLET_DIR)/src/hle/*.cpp) \
	$(wildcard $(ARMLET_DIR)/src/native/*.cpp) \
	$(ARMLET_PRSP_DIR)/rsp/vfunctions.cpp \
	$(ARMLET_PRSP_DIR)/rsp_jit.cpp \
	$(ARMLET_PRSP_DIR)/jit_allocator.cpp \
	$(ARMLET_PRSP_DIR)/rsp_disasm.cpp \
	$(ARMLET_PRSP_DIR)/rsp/ls.cpp \
	$(ARMLET_PRSP_DIR)/rsp/reciprocal.cpp \
	$(ARMLET_PRSP_DIR)/rsp/cp0.cpp \
	$(ARMLET_PRSP_DIR)/rsp/cp2.cpp \
	$(ARMLET_PRSP_DIR)/shadow.cpp \
	$(ARMLET_PRSP_DIR)/rsp/vu_inline.cpp \
	$(ARMLET_PRSP_DIR)/arch/simd/rsp/rsp_core.cpp \
	$(ARMLET_PRSP_DIR)/parallel.cpp

ARMLET_DEFINES  = -DARMLET_NATIVE -DARMLET_RDP_DEFER -DHAVE_MMAP=1
ARMLET_LIGHTNING_INC = -I$(ARMLET_PRSP_DIR)/lightning/include
# rsp-hle's memory.h / common.h / audio.h are only on the C side, as in arMLEt's CMake build
ARMLET_CFLAGS   = -std=gnu11 $(ARMLET_DEFINES) $(POW2_API_INC) -I$(ARMLET_DIR)/src -I$(ARMLET_HLE_DIR) \
	-I$(ARMLET_PRSP_DIR) $(ARMLET_LIGHTNING_INC) -include $(POW2_DIR)/rename-armlet.h -Ddlsym=pow2_dlsym
ARMLET_CXXFLAGS = -std=gnu++14 -ffast-math -fvisibility-inlines-hidden $(ARMLET_DEFINES) \
	-DPARALLEL_INTEGRATION -DM64P_PLUGIN_API -DPARALLEL_RSP_LIGHTNING -DPRSP_RDP_DEFER -DPRSP_NATIVE \
	$(POW2_API_INC) -I$(ARMLET_DIR)/src -I$(ARMLET_PRSP_DIR) -I$(ARMLET_PRSP_DIR)/arch/simd/rsp \
	$(ARMLET_LIGHTNING_INC) -include $(POW2_DIR)/rename-armlet.h

SOURCES_C   += $(ARMLET_SOURCES_C) $(ARMLET_HLE_SOURCES_C) $(ARMLET_LIGHTNING_SOURCES_C)
SOURCES_CXX += $(ARMLET_SOURCES_CXX)
$(ARMLET_SOURCES_C:.c=.o): CFLAGS = $(POW2_CPUOPTS) $(ARMLET_CFLAGS)
$(ARMLET_HLE_SOURCES_C:.c=.o): CFLAGS = $(POW2_CPUOPTS) $(ARMLET_CFLAGS) -ffast-math
$(ARMLET_LIGHTNING_SOURCES_C:.c=.o): CFLAGS = $(POW2_CPUOPTS) -std=gnu11 -DHAVE_MMAP=1 $(ARMLET_LIGHTNING_INC)
$(ARMLET_SOURCES_CXX:.cpp=.o): CXXFLAGS = $(POW2_CPUOPTS) $(ARMLET_CXXFLAGS)

# vu_inline.cpp holds the VU op bodies the aarch64 JIT copies into its code:
# they must leave every register the JIT keeps live alone, and stay out of LTO
ifeq ($(WITH_DYNAREC), aarch64)
$(ARMLET_PRSP_DIR)/rsp/vu_inline.o: CXXFLAGS += -fno-lto -ffixed-x9 -ffixed-x10 -ffixed-x11 -ffixed-x12 -ffixed-x13 \
	-ffixed-x14 -ffixed-x15 -ffixed-x18 -ffixed-x20 -ffixed-x21 -ffixed-x22 -ffixed-x23 -ffixed-x24 -ffixed-x25 \
	-ffixed-x26 -ffixed-x27 -ffixed-x28
endif
